# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=false

# Local infrastructure (Docker Compose defaults)
DATABASE_URL=postgresql://devforge:devforge@localhost:5432/devforge?schema=public
DIRECT_URL=postgresql://devforge:devforge@localhost:5432/devforge?schema=public
REDIS_URL=redis://localhost:6379

# Authentication
BETTER_AUTH_SECRET=devforge-dev-secret-change-in-production

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate Limiting & Proxy Configuration
# Set TRUST_PROXY=true when behind reverse proxies / CDN (e.g. Vercel, Cloudflare, AWS ALB)
TRUST_PROXY=true

# Distributed rate limiter across serverless instances (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

